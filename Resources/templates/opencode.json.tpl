{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{ accent }}",
    "secondary": "{{ magenta }}",
    "accent": "{{ cyan }}",
    "error": "{{ red }}",
    "warning": "{{ yellow }}",
    "success": "{{ green }}",
    "info": "{{ cyan }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ mix foreground background 34% }}",
    "selectedListItemText": "{{ background }}",
    "background": "{{ background }}",
    "backgroundPanel": "{{ mix background foreground 6% }}",
    "backgroundElement": "{{ mix background foreground 10% }}",
    "backgroundMenu": "{{ mix background foreground 10% }}",
    "borderSubtle": "{{ mix background foreground 20% }}",
    "border": "{{ mix background foreground 30% }}",
    "borderActive": "{{ mix background foreground 40% }}",
    "diffAdded": "{{ green }}",
    "diffRemoved": "{{ red }}",
    "diffContext": "{{ mix background foreground 30% }}",
    "diffHunkHeader": "{{ mix background foreground 30% }}",
    "diffHighlightAdded": "{{ bright_green }}",
    "diffHighlightRemoved": "{{ bright_red }}",
    "diffAddedBg": "{{ mix background green 20% }}",
    "diffRemovedBg": "{{ mix background red 20% }}",
    "diffContextBg": "{{ mix background foreground 6% }}",
    "diffLineNumber": "{{ mix foreground background 34% }}",
    "diffAddedLineNumberBg": "{{ mix background green 14% }}",
    "diffRemovedLineNumberBg": "{{ mix background red 14% }}",
    "markdownText": "{{ foreground }}",
    "markdownHeading": "{{ foreground }}",
    "markdownLink": "{{ blue }}",
    "markdownLinkText": "{{ cyan }}",
    "markdownCode": "{{ green }}",
    "markdownBlockQuote": "{{ yellow }}",
    "markdownEmph": "{{ yellow }}",
    "markdownStrong": "{{ foreground }}",
    "markdownHorizontalRule": "{{ mix background foreground 30% }}",
    "markdownListItem": "{{ blue }}",
    "markdownListEnumeration": "{{ cyan }}",
    "markdownImage": "{{ blue }}",
    "markdownImageText": "{{ cyan }}",
    "markdownCodeBlock": "{{ foreground }}",
    "syntaxComment": "{{ mix foreground background 34% }}",
    "syntaxKeyword": "{{ magenta }}",
    "syntaxFunction": "{{ blue }}",
    "syntaxVariable": "{{ foreground }}",
    "syntaxString": "{{ green }}",
    "syntaxNumber": "{{ yellow }}",
    "syntaxType": "{{ cyan }}",
    "syntaxOperator": "{{ cyan }}",
    "syntaxPunctuation": "{{ foreground }}"
  }
}
